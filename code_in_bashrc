# docker_bash_tools (version-2 + interactive container picker)
#
# Install:
#   install -m 644 code_in_bashrc ~/.docker_tools
#   grep -qxF 'source ~/.docker_tools' ~/.bashrc || echo 'source ~/.docker_tools' >> ~/.bashrc
#   source ~/.bashrc
#
# Every container command works three ways:
#   dstop            -> menu of ALL containers (running first; fzf fuzzy search if installed)
#   dstop web        -> menu of containers whose name contains "web"
#                       (an exact name skips the menu; a single match is used directly)
#   dstop web-1      -> exact name
# Requires bash 4+ (mapfile) and GNU date. Optional: fzf (fuzzy picker + preview pane),
# column (aligned menus/tables).
#
# Colors: only when output is a terminal. Turn them off with NO_COLOR=1 or DTOOLS_COLOR=0.
# Fzf preview pane: turn off with DTOOLS_PREVIEW=0.

# Older versions defined these as aliases. A leftover alias breaks the function
# definitions below (syntax error near '('), so drop them first.
unalias dps dcps 2>/dev/null

# ---------------------------------------------------------------------------
# Color helpers
# ---------------------------------------------------------------------------

# _dcolor_on [fd]  -> true when colors are wanted on that fd (default 1 = stdout)
_dcolor_on() { [[ -z ${NO_COLOR-} && ${DTOOLS_COLOR:-1} == 1 && -t ${1:-1} ]]; }

# _dpaint good|bad|warn|dim|bold TEXT   (green / red / yellow / dim / bold)
_dpaint() {
  local c
  case $1 in
    good) c=32 ;; bad) c=31 ;; warn) c=33 ;; dim) c=2 ;; bold) c=1 ;;
    *) printf '%s' "$2"; return ;;
  esac
  printf '\e[%sm%s\e[0m' "$c" "$2"
}

# Colorize columns of an already aligned table (stdin -> stdout), found by header name.
#   _dcolorize 1 STATUS          -> color the STATUS column (and bold the header)
#   _dcolorize 0 ...             -> no colors, plain passthrough
# Output without a matching header (e.g. dps -q, custom --format) passes through untouched.
_dcolorize() {
  local on=$1; shift
  if [[ $on != 1 ]]; then cat; return; fi
  awk -v cols="$*" '
  function paint(k, s) { return (k == "") ? s : "\033[" code[k] "m" s "\033[0m" }
  function kind(t) {
    if (t ~ /unhealthy/) return "bad"
    if (t ~ /health: starting|Paused|paused|Restarting|restarting|Created|created|^starting$|^exited$/) return "warn"
    if (t ~ /^Exited \(0\)/) return "dim"
    if (t ~ /^(Exited|Dead|dead)/) return "bad"
    if (t ~ /^(Up|running|healthy)/) return "good"
    if (t == "-" || t == "N/A") return "dim"
    return ""
  }
  function rkind(t) { if (t == "") return ""; if (t + 0 >= 5) return "bad"; if (t + 0 > 0) return "warn"; return "dim" }
  function skind(t) { if (t ~ /^up /) return "good"; if (t ~ /^down /) return "dim"; if (t == "-") return "dim"; return "" }
  BEGIN { code["good"] = 32; code["bad"] = 31; code["warn"] = 33; code["dim"] = 2; n = split(cols, want, " ") }
  NR == 1 {
    nh = 0; found = 0
    for (i = 1; i <= length($0); i++)
      if (substr($0, i, 1) != " " && (i == 1 || substr($0, i - 1, 1) == " ")) {
        nh++; st[nh] = i; w = substr($0, i); sub(/ .*/, "", w); nm[nh] = w
        for (j = 1; j <= n; j++) if (want[j] == w) { found = 1; wanted[nh] = 1 }
      }
    if (!found) { pass = 1; print; next }
    print "\033[1m" $0 "\033[0m"; next
  }
  pass { print; next }
  {
    line = $0; out = ""; pos = 1
    for (h = 1; h <= nh; h++) {
      if (!wanted[h]) continue
      s = st[h]; e = (h < nh) ? st[h + 1] - 1 : length(line)
      if (s > length(line)) continue
      cell = substr(line, s, e - s + 1)
      val = cell; sub(/ +$/, "", val)
      pad = substr(cell, length(val) + 1)
      if (nm[h] == "RESTARTS") k = rkind(val); else if (nm[h] == "SINCE") k = skind(val); else k = kind(val)
      out = out substr(line, pos, s - pos) paint(k, val) pad
      pos = e + 1
    }
    print out substr(line, pos)
  }'
}

# Color kind for a `docker ps` STATUS text (used by the numbered menu)
_dstatus_kind() {
  case $1 in
    *unhealthy*) echo bad ;;
    *"health: starting"*|*Paused*|*Restarting*|*Created*) echo warn ;;
    "Exited (0)"*) echo dim ;;
    Exited*|Dead*) echo bad ;;
    Up*) echo good ;;
  esac
}

# Color kind for an inspect State (+ health + exit code)
_dstate_kind() {
  case $1 in
    running)
      case $2 in unhealthy) echo bad ;; starting) echo warn ;; *) echo good ;; esac ;;
    exited) [[ $3 == 0 ]] && echo warn || echo bad ;;
    dead) echo bad ;;
    *) echo warn ;;
  esac
}

# _dkv ON LABEL VALUE [kind]  -> "Label: value" (bold label, colored value when ON=1)
_dkv() {
  if [[ $1 == 1 ]]; then
    printf '\e[1m%s:\e[0m ' "$2"
    _dpaint "$4" "$3"
    printf '\n'
  else
    printf '%s: %s\n' "$2" "$3"
  fi
}

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

# _dpick [partial-name] [label] [extra docker filter, e.g. status=running]
# Prints the chosen container name on stdout. Menu/prompts go to stderr.
# Also echoes "Selected container: NAME" to stderr so you see what the action will hit.
_dpick() {
  local c
  c=$(_dpick_menu "$@") || return 1
  if _dcolor_on 2; then
    printf 'Selected container: \e[1m%s\e[0m\n' "$c" >&2
  else
    echo "Selected container: $c" >&2
  fi
  printf '%s\n' "$c"
}

# The actual selection logic (exact name / fzf / numbered menu)
_dpick_menu() {
  local pattern=$1 label=${2:-container} extra=$3 sel i n st im pad color=0
  local -a args=(-a) rows names fzf_args
  [[ -n $pattern ]] && args+=(--filter "name=$pattern")
  [[ -n $extra ]]   && args+=(--filter "$extra")

  # Running containers first, stopped ones after (docker's order is kept inside each group)
  mapfile -t rows < <(docker ps "${args[@]}" --format $'{{.State}}\t{{.Names}}\t{{.Status}}\t{{.Image}}' \
                      | awk -F'\t' '{ k = ($1 == "running") ? 0 : 1; print k "\t" $0 }' \
                      | sort -s -t $'\t' -k1,1n | cut -f3-)
  if (( ${#rows[@]} == 0 )); then
    echo "No matching containers found${pattern:+ for name '$pattern'}." >&2
    return 1
  fi
  names=("${rows[@]%%$'\t'*}")

  # An exact name always wins, no menu needed
  if [[ -n $pattern ]]; then
    for n in "${names[@]}"; do
      [[ $n == "$pattern" ]] && { printf '%s\n' "$n"; return 0; }
    done
  fi

  # Fuzzy picker when fzf is available (with a preview pane: ports + last log lines)
  if command -v fzf >/dev/null 2>&1 && [[ -t 0 ]]; then
    fzf_args=(--prompt="$label> " --reverse -1)
    if [[ ${DTOOLS_PREVIEW:-1} == 1 ]]; then
      fzf_args+=(--height=70% --preview-window='right,50%,wrap'
                 --preview='printf "Ports:\n"; docker port {1} 2>/dev/null; printf "\nLast logs:\n"; docker logs --tail 15 {1} 2>&1')
    else
      fzf_args+=(--height=40%)
    fi
    sel=$(printf '%s\n' "${rows[@]}" | _dtable | fzf "${fzf_args[@]}") || return 1
    printf '%s\n' "${sel%%[[:space:]]*}"
    return 0
  fi

  # Plain numbered menu
  if (( ${#names[@]} == 1 )); then
    printf '%s\n' "${names[0]}"
    return 0
  fi
  _dcolor_on 2 && color=1
  for i in "${!rows[@]}"; do
    IFS=$'\t' read -r n st im <<<"${rows[i]}"
    printf -v pad '%-24s' "$st"
    (( color )) && pad=$(_dpaint "$(_dstatus_kind "$st")" "$pad")
    printf '%2d) %-28s %s %s\n' $((i + 1)) "$n" "$pad" "$im" >&2
  done
  read -rp "Select $label number: " sel
  if [[ $sel =~ ^[0-9]+$ ]] && (( sel >= 1 && sel <= ${#names[@]} )); then
    printf '%s\n' "${names[sel-1]}"
  else
    echo "Invalid selection. Please enter a valid number." >&2
    return 1
  fi
}

# y/N confirmation for destructive commands
_dconfirm() { local a; read -rp "$1 [y/N] " a; [[ $a == [yY]* ]]; }

# seconds -> HHh:MMm:SSs
_dfmt_dur() { printf '%02dh:%02dm:%02ds' $(($1 / 3600)) $(($1 % 3600 / 60)) $(($1 % 60)); }

# seconds -> short age: 42s, 5m, 3h12m, 4d06h
_dfmt_age() {
  local s=$1
  if   (( s < 60 ));    then printf '%ds' "$s"
  elif (( s < 3600 ));  then printf '%dm' $((s / 60))
  elif (( s < 86400 )); then printf '%dh%02dm' $((s / 3600)) $((s % 3600 / 60))
  else                       printf '%dd%02dh' $((s / 86400)) $((s % 86400 / 3600))
  fi
}

# Align tab-separated columns (falls back to raw tabs when `column` is missing)
_dtable() { if command -v column >/dev/null 2>&1; then column -t -s $'\t'; else cat; fi; }

# Shorten `docker ps` style ports: drop the 0.0.0.0: prefix and duplicate [::] mappings
_dports_trim() { sed -E 's/, \[::\]:[0-9-]+->[0-9-]+\/(tcp|udp)//g; s/0\.0\.0\.0://g'; }

# "80/tcp -> 0.0.0.0:8080; 443/tcp -> N/A; " -> "80/tcp -> 8080": published ports only
_dports_short() {
  local IFS=';' item out=
  for item in $1; do
    item=${item# }
    [[ -z $item || $item == *"-> N/A" ]] && continue
    item=${item//0.0.0.0:/}
    out+="${out:+, }$item"
  done
  printf '%s' "${out:--}"
}

