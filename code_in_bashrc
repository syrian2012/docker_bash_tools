#List dockers with less, in a colored table that fits the screen
#  dps            name, status, image, short ports
#  dps -a         same, including stopped containers
#  dps --full     docker's normal wide output (extra flags allowed: dps --full -a)
#  dps -q / --filter ... / any other flag -> docker ps exactly as you typed it
dps() {
  local full=0 other=0 a color=0
  local -a args=()
  _dcolor_on && color=1
  for a in "$@"; do
    case $a in
      --full)   full=1 ;;
      -a|--all) args+=("$a") ;;
      *)        args+=("$a"); other=1 ;;
    esac
  done
  if (( full || other )); then
    docker ps "${args[@]}" | _dcolorize "$color" STATUS | less -FRSX
  else
    docker ps "${args[@]}" --format $'table {{.Names}}\t{{.Status}}\t{{.Image}}\t{{.Ports}}' \
      | _dports_trim | _dcolorize "$color" STATUS | less -FRSX
  fi
}

#List compose stack with less, in a colored table that fits the screen
#  dcps [service...]   service, name, status, short ports (add -a for stopped ones)
#  dcps --full         compose's normal output; any other flag is passed through untouched
dcps() {
  local full=0 other=0 a color=0
  local -a args=()
  _dcolor_on && color=1
  for a in "$@"; do
    case $a in
      --full)   full=1 ;;
      -a|--all) args+=("$a") ;;
      -*)       args+=("$a"); other=1 ;;
      *)        args+=("$a") ;;            # service names
    esac
  done
  if (( full || other )); then
    docker compose ps "${args[@]}" | _dcolorize "$color" STATUS | less -FRSX
  else
    { docker compose ps --format $'table {{.Service}}\t{{.Name}}\t{{.Status}}\t{{.Ports}}' "${args[@]}" 2>/dev/null \
        || docker compose ps "${args[@]}"; } | _dports_trim | _dcolorize "$color" STATUS | less -FRSX
  fi
}

# ---------------------------------------------------------------------------
# Container information
# ---------------------------------------------------------------------------

# Optional batcat viewer for finite, human-readable output.
# Falls back to normal output when batcat is not installed.
_dbat() {
  local lang=${1:-text}
  if command -v batcat >/dev/null 2>&1; then
    batcat --style=plain --paging=auto --language="$lang"
  else
    cat
  fi
}

# One `docker container inspect` template for everything we show (fields separated by '|')
_DINFO_FMT='{{.Name}}|{{.Id}}|{{.Config.Image}}|{{.State.Status}}|{{.State.StartedAt}}|{{.State.FinishedAt}}|{{.Created}}|{{with index .State "Health"}}{{.Status}}{{else}}none{{end}}|{{.RestartCount}}|{{.HostConfig.RestartPolicy.Name}}|{{.State.ExitCode}}|{{.State.OOMKilled}}|{{range $k,$v := .NetworkSettings.Networks}}{{$k}}={{$v.IPAddress}} {{end}}|{{range $p,$conf := .NetworkSettings.Ports}}{{$p}}{{if $conf}} -> {{(index $conf 0).HostIp}}:{{(index $conf 0).HostPort}}{{else}} -> N/A{{end}}; {{end}}'

# Read _DINFO_FMT lines on stdin, print the full information block for each
_dinfo_blocks() {
  local now name id image state started finished created health restarts policy exitcode oom ips ports
  local st s f c ec first=1 on=0 rk
  _dcolor_on && on=1
  now=$(date +%s)
  while IFS='|' read -r name id image state started finished created health restarts policy exitcode oom ips ports; do
    name=${name#/}; ips=${ips% }; ports=${ports%; }
    (( first )) || echo ""
    first=0

    st=$state
    [[ $health != none ]] && st+=" ($health)"

    _dkv "$on" Name  "$name"
    _dkv "$on" ID    "${id:0:12}"
    _dkv "$on" Image "$image"
    _dkv "$on" State "$st" "$(_dstate_kind "$state" "$health" "$exitcode")"

    if [[ $started == 0001-* ]]; then
      _dkv "$on" "Up Since" "never started" dim
    elif [[ $state == running || $finished == 0001-* ]]; then
      s=$(date -d "$started" +%s)
      _dkv "$on" "Up Since" "$(date -d "@$s" '+%Y-%m-%d %H:%M:%S %Z')"
      _dkv "$on" "Up Duration" "$(_dfmt_dur $((now - s)))"
    else
      s=$(date -d "$started" +%s)
      f=$(date -d "$finished" +%s)
      _dkv "$on" "Last Started" "$(date -d "@$s" '+%Y-%m-%d %H:%M:%S %Z')"
      _dkv "$on" "Stopped Since" "$(date -d "@$f" '+%Y-%m-%d %H:%M:%S %Z')"
      _dkv "$on" "Stopped For" "$(_dfmt_dur $((now - f)))"
      ec="$exitcode"
      [[ $oom == true ]] && ec+=" (OOM killed)"
      if [[ $exitcode != 0 || $oom == true ]]; then _dkv "$on" "Exit Code" "$ec" bad; else _dkv "$on" "Exit Code" "$ec"; fi
    fi

    rk=
    (( restarts >= 5 )) && rk=bad
    [[ -z $rk ]] && (( restarts > 0 )) && rk=warn
    _dkv "$on" Restarts "$restarts (policy: ${policy:-no})" "$rk"

    c=$(date -d "$created" +%s)
    _dkv "$on" "Created From" "$(date -d "@$c" '+%Y-%m-%d %H:%M:%S %Z')"
    _dkv "$on" "Creation Duration" "$(_dfmt_dur $((now - c)))"
    if [[ -n $ips ]];   then _dkv "$on" "IP Address" "$ips";   else _dkv "$on" "IP Address" "N/A" dim; fi
    if [[ -n $ports ]]; then _dkv "$on" Ports "$ports";        else _dkv "$on" Ports "N/A" dim; fi
  done
}

# Read _DINFO_FMT lines on stdin, print one compact table row per container
_dinfo_table() {
  local now name id image state started finished created health restarts policy exitcode oom ips ports since on=0
  _dcolor_on && on=1
  now=$(date +%s)
  {
    printf 'NAME\tSTATE\tHEALTH\tRESTARTS\tSINCE\tIMAGE\tPORTS\n'
    while IFS='|' read -r name id image state started finished created health restarts policy exitcode oom ips ports; do
      name=${name#/}; ports=${ports%; }
      [[ $health == none ]] && health=-
      if   [[ $started == 0001-* ]]; then
        since=-
      elif [[ $state == running || $finished == 0001-* ]]; then
        since="up $(_dfmt_age $((now - $(date -d "$started" +%s))))"
      else
        since="down $(_dfmt_age $((now - $(date -d "$finished" +%s))))"
      fi
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$state" "$health" "$restarts" "$since" "$image" "$(_dports_short "$ports")"
    done
  } | _dtable | _dcolorize "$on" STATE HEALTH RESTARTS SINCE
}

#Get information of a container
dinfo() {
  local c
  c=$(_dpick "$1") || return
  docker container inspect --format "$_DINFO_FMT" "$c" | _dinfo_blocks | _dbat ini
}

# Grep all containers with their information
#   dgrep [pattern]       full block for every matching container (one docker call)
#   dgrep -t [pattern]    compact table, one line per container
dgrep() {
  local table=0 pattern=
  local -a names args=(-a)
  while (( $# )); do
    case $1 in
      -t|--table) table=1 ;;
      *)          pattern=$1 ;;
    esac
    shift
  done
  [[ -n $pattern ]] && args+=(--filter "name=$pattern")
  mapfile -t names < <(docker ps "${args[@]}" --format '{{.Names}}')
  if (( ${#names[@]} == 0 )); then
    echo "No matching containers found${pattern:+ for name '$pattern'}." >&2
    return 1
  fi
  if (( table )); then
    docker container inspect --format "$_DINFO_FMT" "${names[@]}" | _dinfo_table | _dbat tsv
  else
    docker container inspect --format "$_DINFO_FMT" "${names[@]}" | _dinfo_blocks | _dbat ini
  fi
}

# Inspect container
dinspect() {
  local c
  c=$(_dpick "$1") || return
  docker inspect "$c" | _dbat json
}

# ---------------------------------------------------------------------------
# Run things inside containers (running containers only in the menu)
# ---------------------------------------------------------------------------

# bash into an existing container (falls back to sh when bash is missing)
dbash() {
  local c
  c=$(_dpick "$1" container status=running) || return
  docker exec -ti "$c" sh -c 'command -v bash >/dev/null 2>&1 && exec bash || exec sh'
}

# sh into an existing container
dsh() {
  local c
  c=$(_dpick "$1" container status=running) || return
  docker exec -ti "$c" /bin/sh
}

# Execute something in an existing container
#   dex web ls -la /etc     (all arguments are passed through)
#   dex                     (pick container, then asked for the command)
dex() {
  local c cmd
  c=$(_dpick "$1" container status=running) || return
  if (( $# > 1 )); then
    shift
    docker exec -ti "$c" "$@"
  else
    read -rp "Command to run in $c: " cmd
    [[ -n $cmd ]] && docker exec -ti "$c" sh -c "$cmd"
  fi
}

# ---------------------------------------------------------------------------
# Lifecycle
# ---------------------------------------------------------------------------

# Start an existing container
dstart() {
  local c
  c=$(_dpick "$1") || return
  docker start "$c"
}

# Restart an existing container
drestart() {
  local c
  c=$(_dpick "$1") || return
  docker restart "$c"
}

# Stop an existing container
dstop() {
  local c
  c=$(_dpick "$1" container status=running) || return
  docker stop "$c"
}

# Remove an existing container (asks first)
drm() {
  local c
  c=$(_dpick "$1") || return
  _dconfirm "Remove container $c?" && docker rm "$c"
}

# Stop and remove an existing container (asks first)
dsrm() {
  local c
  c=$(_dpick "$1") || return
  _dconfirm "Stop and remove container $c?" && docker stop "$c" && docker rm "$c"
}

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------

# Get logs of an existing container: last 200 lines by default (set DLOG_TAIL to change)
#   dlog                      pick, then last 200 lines
#   dlog web -f               follow, starting from the last 200 lines
#   dlog web --tail 1000      your own --tail / -n / --since / --until wins
#   dlog web --tail all       everything
#   dlog -f                   pick, then follow
dlog() {
  local p= c a custom=0
  if [[ -n $1 && $1 != -* ]]; then p=$1; shift; fi
  c=$(_dpick "$p") || return
  for a in "$@"; do
    case $a in
      --tail|--tail=*|-n|-n[0-9]*|--since|--since=*|--until|--until=*) custom=1 ;;
    esac
  done
  if (( custom )); then
    docker logs "$@" "$c"
  else
    docker logs --tail "${DLOG_TAIL:-200}" "$@" "$c"
  fi
}

#clear the logs for specific container (needs root: the log file is owned by root)
dlogc() {
  local c p s=
  c=$(_dpick "$1") || return
  p=$(docker inspect --format '{{.LogPath}}' "$c")
  if [[ -z $p ]]; then
    echo "No json-file log found for $c (different log driver?)" >&2
    return 1
  fi
  (( EUID )) && s=sudo
  $s truncate -s 0 "$p" && echo "Logs cleared for container $c"
}

# ---------------------------------------------------------------------------
# Tab completion for the first argument (container names)
# ---------------------------------------------------------------------------
_dcomp() {
  (( COMP_CWORD == 1 )) || return
  COMPREPLY=( $(compgen -W "$(docker ps -a --format '{{.Names}}' 2>/dev/null)" -- "${COMP_WORDS[1]}") )
}
complete -F _dcomp dbash dsh dex dstart drestart dstop drm dsrm dlog dlogc dinfo dinspect dgrep

# ---------------------------------------------------------------------------
# Interactive Help Menu with Live Preview & Pre-fill
# ---------------------------------------------------------------------------
dhelp() {
    local initial_query="$1"
    local selected_cmd

    # Helper function to print detailed help for each command
    # (Must be exported so fzf's preview subshell can execute it)
    _get_help_text() {
        case "$1" in
            dps)      cat <<'EOF'
  dps [flags]
    List running containers in a colorized, paged table.
    Usage:
      dps            Show running containers (shortened ports).
      dps -a         Include stopped containers.
      dps --full     Show Docker's default wide output.
      dps -q         Pass-through to native docker ps.
EOF
            ;;
            dcps)     cat <<'EOF'
  dcps [service...]
    List Docker Compose stack containers in a colorized, paged table.
    Usage:
      dcps           Show all services in the current compose project.
      dcps web       Show only the 'web' service.
      dcps -a        Include stopped containers.
      dcps --full    Show Compose's default output.
EOF
            ;;
            dinfo)    cat <<'EOF'
  dinfo [name]
    Display a beautiful, colorized dashboard of a container's state.
    Shows: Name, ID, Image, State, Health, Up Since/Duration, Restarts, IP, Ports.
    Usage:
      dinfo          Interactive picker.
      dinfo web      Filter by name "web".
      dinfo web-1    Exact name match (skips picker).
EOF
            ;;
            dgrep)    cat <<'EOF'
  dgrep [-t] [pattern]
    Search across all containers by name and display their info.
    Usage:
      dgrep web      Show full info dashboard for containers matching "web".
      dgrep -t web   Show a compact, colorized table instead of the full dashboard.
EOF
            ;;
            dinspect) cat <<'EOF'
  dinspect [name]
    Show the raw 'docker inspect' JSON output with syntax highlighting (via batcat).
    Usage:
      dinspect       Interactive picker.
      dinspect web   Inspect container "web".
EOF
            ;;
            dbash)    cat <<'EOF'
  dbash [name]
    Open an interactive shell inside a running container.
    Automatically tries 'bash', and falls back to 'sh' if bash is missing.
    Usage:
      dbash          Interactive picker (running containers only).
      dbash web      Exec into "web".
EOF
            ;;
            dsh)      cat <<'EOF'
  dsh [name]
    Open a '/bin/sh' shell inside a running container.
    Usage:
      dsh            Interactive picker (running containers only).
      dsh web        Exec into "web" using sh.
EOF
            ;;
            dex)      cat <<'EOF'
  dex [name] <command>
    Execute a specific command inside a running container.
    Usage:
      dex web ls -la   Run 'ls -la' in "web".
      dex              Pick a container, then prompts you for the command.
EOF
            ;;
            dstart)   cat <<'EOF'
  dstart [name]
    Start an existing stopped container.
    Usage:
      dstart         Interactive picker.
      dstart web     Start "web".
EOF
            ;;
            drestart) cat <<'EOF'
  drestart [name]
    Restart an existing container.
    Usage:
      drestart       Interactive picker.
      drestart web   Restart "web".
EOF
            ;;
            dstop)    cat <<'EOF'
  dstop [name]
    Stop a running container.
    Usage:
      dstop          Interactive picker (running containers only).
      dstop web      Stop "web".
EOF
            ;;
            drm)      cat <<'EOF'
  drm [name]
    Remove an existing container. Prompts for [y/N] confirmation.
    Usage:
      drm            Interactive picker.
      drm web        Remove "web" (asks for confirmation).
EOF
            ;;
            dsrm)     cat <<'EOF'
  dsrm [name]
    Stop and then remove an existing container. Prompts for [y/N] confirmation.
    Usage:
      dsrm           Interactive picker.
      dsrm web       Stop and remove "web".
EOF
            ;;
            dlog)     cat <<'EOF'
  dlog [name] [flags]
    View container logs. Defaults to the last 200 lines (configurable via DLOG_TAIL).
    Usage:
      dlog           Interactive picker, show last 200 lines.
      dlog web -f    Follow logs for "web".
      dlog web --tail 500  Show last 500 lines.
EOF
            ;;
            dlogc)    cat <<'EOF'
  dlogc [name]
    Clear/truncate the JSON log file for a container on the host.
    Requires root/sudo privileges.
    Usage:
      dlogc          Interactive picker.
      dlogc web      Clear logs for "web".
EOF
            ;;
            dstats)   cat <<'EOF'
  dstats [interval] [name]
    Live, colorized resource stats for one or more containers.
    Usage:
      dstats          Show live stats for all containers every 3 seconds.
      dstats 5        Show live stats for all containers every 5 seconds.
      dstats web      Show live stats for containers matching "web".
      dstats 10 api   Show live stats for containers matching "api" every 10 seconds.
    Notes:
      Press Ctrl+C to exit. The cursor is hidden during refreshes.
EOF
            ;;
            # Compose & Native Aliases
            dcup|dcdown|dcstart|dcstop|dcrestart|dcpull|dcbuild)
                cat <<EOF
  $1
    Shortcut for 'docker compose ${1#dc}'.
    (e.g., 'dcup' runs 'docker compose up -d')
EOF
            ;;
            drmi|dimgs|db)
                cat <<EOF
  $1
    Shortcut for 'docker ${1#d}'.
    (e.g., 'db' runs 'docker build .')
EOF
            ;;
            *)
                echo "Unknown command: $1"
                return 1
                ;;
        esac
    }

    # List of all available commands
    local commands=(
        dps dcps dinfo dgrep dinspect
        dbash dsh dex
        dstart drestart dstop drm dsrm
        dlog dlogc dstats
        dcup dcdown dcstart dcstop dcrestart dcpull dcbuild
        drmi dimgs db
    )

    # 1. Fuzzy picker when fzf is available
    if command -v fzf >/dev/null 2>&1 && [[ -t 0 ]]; then
        # Export the function so fzf's preview subshell can execute it
        export -f _get_help_text

        local fzf_args=(
            --prompt="Select a docker tool> "
            --height=60%
            --reverse
            --border
            --preview='_get_help_text {}'
            # Preview on the RIGHT side, taking 50% width, with a border on its left
            --preview-window='right,50%,wrap,border-left' 
        )

        # Pre-fill the search query if an argument was provided
        if [[ -n "$initial_query" ]]; then
            fzf_args+=(--query="$initial_query")
        fi

        selected_cmd=$(printf '%s\n' "${commands[@]}" | fzf "${fzf_args[@]}")
    else
        # 2. Fallback to plain text if fzf is missing
        if [[ -n "$initial_query" ]]; then
            # If they typed a command name directly without fzf, just show it
            local is_valid=0
            for cmd in "${commands[@]}"; do
                if [[ "$cmd" == "$initial_query" ]]; then
                    is_valid=1
                    break
                fi
            done
            if (( is_valid )); then
                selected_cmd="$initial_query"
            else
                echo "Unknown tool: $initial_query" >&2
                return 1
            fi
        else
            # Plain numbered menu
            echo "Available Docker Tools:"
            local i
            for i in "${!commands[@]}"; do
                printf '  %2d) %s\n' $((i + 1)) "${commands[$i]}"
            done
            read -rp "Select tool number (or name): " sel
            if [[ $sel =~ ^[0-9]+$ ]] && (( sel >= 1 && sel <= ${#commands[@]} )); then
                selected_cmd="${commands[$((sel - 1))]}"
            else
                for cmd in "${commands[@]}"; do
                    if [[ "$cmd" == "$sel" ]]; then
                        selected_cmd="$cmd"
                        break
                    fi
                done
            fi
        fi
    fi

    # 3. Print the selected help text
    if [[ -n "$selected_cmd" ]]; then
        # Print colored header
        if _dcolor_on; then
            printf '\n\e[1;36mHelp for: %s\e[0m\n' "$selected_cmd"
            printf '\e[2m%s\e[0m\n\n' "────────────────────────────────────────"
        else
            printf '\nHelp for: %s\n' "$selected_cmd"
            printf '%s\n\n' "----------------------------------------"
        fi
        
        # Print the actual help documentation
        _get_help_text "$selected_cmd"
        echo
    fi
}

# Tab completion specifically for dhelp (completes tool names, not container names)
_dhelp_comp() {
    local commands=(dps dcps dinfo dgrep dinspect dbash dsh dex dstart drestart dstop drm dsrm dlog dlogc dstats dcup dcdown dcstart dcstop dcrestart dcpull dcbuild drmi dimgs db)
    COMPREPLY=( $(compgen -W "${commands[*]}" -- "${COMP_WORDS[1]}") )
}
complete -F _dhelp_comp dhelp

# Live, colorized resource stats with configurable refresh interval
# Usage:
#   dstats             -> 3s refresh, all containers
#   dstats 5           -> 5s refresh, all containers
#   dstats web         -> 3s refresh, filter by "web"
#   dstats 10 back     -> 10s refresh, filter by "back"
dstats() {
    local interval=3
    local -a targets=()
    local arg

    # 1. Parse arguments: numbers are intervals, strings are container filters
    for arg in "$@"; do
        if [[ "$arg" =~ ^[0-9]+$ ]]; then
            interval="$arg"
        else
            # Resolve container targets
            mapfile -t matches < <(docker ps --format '{{.Names}}' --filter "name=$arg" --filter "status=running")
            if (( ${#matches[@]} == 0 )); then
                echo "No running containers found matching '$arg'." >&2
                return 1
            elif (( ${#matches[@]} == 1 )); then
                targets+=("${matches[0]}")
            else
                local picked
                picked=$(_dpick "$arg" container status=running) || return
                targets+=("$picked")
            fi
        fi
    done

    # 2. Hide the blinking cursor and ensure it's restored on exit
    printf '\e[?25l'
    trap 'printf "\e[?25h"; echo; exit 0' EXIT INT TERM

    # 3. Live update loop
    while true; do
        # Clear screen and move cursor to top-left
        printf '\e[H\e[2J'
        
        # Print bold header
        if _dcolor_on; then
            printf '\e[1m%-25s %-10s %-25s %-10s %-20s %-20s\e[0m\n' "NAME" "CPU %" "MEM USAGE / LIMIT" "MEM %" "NET I/O" "BLOCK I/O"
            printf '\e[2m[Refreshing every %ds | Press Ctrl+C to exit]\e[0m\n' "$interval"
        else
            printf '%-25s %-10s %-25s %-10s %-20s %-20s\n' "NAME" "CPU %" "MEM USAGE / LIMIT" "MEM %" "NET I/O" "BLOCK I/O"
            printf '[Refreshing every %ds | Press Ctrl+C to exit]\n' "$interval"
        fi

        # Fetch stats using tab-separated format
        docker stats --no-stream "${targets[@]}" --format "{{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.MemPerc}}\t{{.NetIO}}\t{{.BlockIO}}" 2>/dev/null | \
        awk -F'\t' '
        NF < 6 { next }
        {
            name = $1; cpu_str = $2; mem_usage = $3; mem_perc_str = $4; net_io = $5; block_io = $6
            
            cpu_val = cpu_str; gsub(/%/, "", cpu_val)
            if (cpu_val + 0 > 80) cpu_col = "\033[31m"
            else if (cpu_val + 0 > 50) cpu_col = "\033[33m"
            else cpu_col = "\033[32m"
            
            mem_val = mem_perc_str; gsub(/%/, "", mem_val)
            if (mem_val + 0 > 80) mem_col = "\033[31m"
            else if (mem_val + 0 > 50) mem_col = "\033[33m"
            else mem_col = "\033[32m"
            
            printf "%-25s %s%-10s\033[0m %-25s %s%-10s\033[0m %-20s %-20s\n", \
                name, cpu_col, cpu_str, mem_usage, mem_col, mem_perc_str, net_io, block_io
        }'
        
        # Wait for the specified interval
        sleep "$interval"
    done
}